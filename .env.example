# =============================================================================
# Ahia backend — environment variables
# =============================================================================
# Copy this file to `.env` and fill in real values for local development.
# In production, set these on Render (Environment tab). Never commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed frontend origins (CORS).
# The first one is the canonical post-OAuth and /r/:code redirect target.
CLIENT_URL=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# Database (Neon Postgres)
# -----------------------------------------------------------------------------
# Pooled connection — use this for runtime queries.
# Append `&connection_limit=20&pool_timeout=20` in prod to handle ~1000 users.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# Optional: direct (non-pooled) URL for migrations only. Recommended on Neon.
DIRECT_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# -----------------------------------------------------------------------------
# Redis (Upstash) — optional in dev, required in prod for presence + counters
# -----------------------------------------------------------------------------
REDIS_URL=

# -----------------------------------------------------------------------------
# Main app session cookie (user app — NOT admin)
# -----------------------------------------------------------------------------
# 32+ char random secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_random_48_byte_hex_string_min_32_chars

# Optional. Leave blank in dev; in production a misconfigured "localhost" is
# silently ignored to prevent cookies from breaking.
COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# Google OAuth (optional in dev — needed for "Sign in with Google")
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# -----------------------------------------------------------------------------
# Apple OAuth (optional, deferred to v2)
# -----------------------------------------------------------------------------
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:4000/auth/apple/callback

# -----------------------------------------------------------------------------
# Cloudinary (image/video uploads)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Paystack (payments)
# -----------------------------------------------------------------------------
# Use sk_test_... for development. Activate live mode + use sk_live_... in prod.
# Test mode caps live bank resolves at 3/day — sellers can't add payout accounts
# beyond that limit. Activate live mode before launch.
PAYSTACK_SECRET_KEY=sk_test_...

# -----------------------------------------------------------------------------
# Resend (transactional email) — not wired yet, leave blank
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# =============================================================================
# Admin app — Phase 1
# =============================================================================
# Set these BEFORE the first admin app deploy. The four below get the first
# super_admin account into the system. After first login + password change,
# REMOVE the BOOTSTRAP vars on the next deploy (the row will exist; bootstrap
# becomes a no-op anyway, but tidy ops).
# -----------------------------------------------------------------------------

# Cookie name for admin sessions. Leave default unless you have a strong reason.
ADMIN_COOKIE_NAME=ahia_admin_session

# 32+ char secret used to sign the short-lived `setupToken` and `loginChallenge`
# JWTs handed to the frontend during 2FA setup / verify. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Can reuse JWT_SECRET if you don't want a separate secret, but separate is
# better (compromised admin secret doesn't affect user sessions).
ADMIN_COOKIE_SECRET=replace_with_random_48_byte_hex_string_min_32_chars

# Email for the first super_admin (admin #1). On first boot after this is set,
# the backend creates an admin_users row with this email IF no admin exists yet.
# You sign in with this + ADMIN_BOOTSTRAP_PASSWORD, set up 2FA, then change
# the password and (optionally) clear these env vars.
ADMIN_BOOTSTRAP_EMAIL=you@example.com

# Temporary password for the first super_admin. Must be at least 12 chars,
# include at least 1 digit and 1 symbol. Will be hashed on first boot.
# CHANGE IMMEDIATELY via POST /admin/auth/change-password after first login.
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeRightAway1!

# Label shown in authenticator apps next to your account. Cosmetic; defaults
# to "Ahia Admin" if unset.
ADMIN_TOTP_ISSUER=Ahia Admin
