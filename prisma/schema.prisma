generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  buyer
  seller
  admin
}

enum MessageType {
  text
  voice
  image
  invoice
  system
}

enum TransactionStatus {
  pending
  held
  partial_released
  fully_released
  partial_refunded
  fully_refunded
}

enum InvoiceStatus {
  pending
  cancelled
  paid
  partial_released
  fully_released
  partial_refunded
  fully_refunded
  disputed
}

enum InvoiceLineKind {
  product
  custom
  discount
}

enum InvoiceLineStatus {
  pending
  released
  refunded
}

enum DisputeStatus {
  open
  reviewing
  resolved
}

enum DisputeResolution {
  refunded_to_buyer
  released_to_seller
}

enum BoostPlan {
  monthly
  quarterly
  biannual
}

enum ReferralStatus {
  pending
  completed
  expired
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String?  @map("password_hash")
  role         UserRole @default(buyer)
  avatarUrl    String?  @map("avatar_url")
  googleId     String?  @unique @map("google_id")
  appleId      String?  @unique @map("apple_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  shops                Shop[]
  follows              Follow[]
  buyerConversations   Conversation[]    @relation("buyerConversations")
  sellerConversations  Conversation[]    @relation("sellerConversations")
  messages             Message[]
  messageReads         MessageRead[]
  messageReactions     MessageReaction[]
  invoicesAsBuyer      Invoice[]         @relation("invoiceBuyer")
  invoicesAsSeller     Invoice[]         @relation("invoiceSeller")
  buyerTransactions    Transaction[]     @relation("buyerTransactions")
  sellerTransactions   Transaction[]     @relation("sellerTransactions")
  disputesRaised       Dispute[]         @relation("disputesRaised")
  reviewsAuthored      Review[]
  notifications        Notification[]
  wishlist             WishlistItem[]
  referralsMade        Referral[]        @relation("referrer")
  referralsReceived    Referral[]        @relation("invitee")

  @@map("users")
}

model Shop {
  id            String    @id @default(uuid()) @db.Uuid
  ownerId       String    @map("owner_id") @db.Uuid
  name          String
  handle        String    @unique
  category      String?
  bio           String?
  avatarUrl     String?   @map("avatar_url")
  bannerUrl     String?   @map("banner_url")
  location      String?
  showLegalName Boolean   @default(false) @map("show_legal_name")
  isActive      Boolean   @default(true) @map("is_active")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  owner         User           @relation(fields: [ownerId], references: [id])
  products      Product[]
  stories       Story[]
  reviews       Review[]
  discoverPosts DiscoverPost[]
  followers     Follow[]
  conversations Conversation[]

  @@index([ownerId])
  @@map("shops")
}

model Follow {
  userId    String   @map("user_id") @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([userId, shopId])
  @@index([shopId])
  @@index([userId])
  @@map("follows")
}

model Product {
  id          String    @id @default(uuid()) @db.Uuid
  shopId      String    @map("shop_id") @db.Uuid
  name        String
  description String
  price       Decimal   @db.Decimal(12, 2)
  category    String
  cover       String
  gallery     String[]
  sponsored   Boolean   @default(false)
  hidden      Boolean   @default(false)
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  shop            Shop           @relation(fields: [shopId], references: [id])
  reviews         Review[]
  boosts          Boost[]
  invoiceLines    InvoiceLine[]  @relation("invoiceLineProduct")
  contextMessages Message[]      @relation("contextProduct")
  wishlistedBy    WishlistItem[]

  @@index([category])
  @@index([shopId])
  @@map("products")
}

model Conversation {
  id              String    @id @default(uuid()) @db.Uuid
  buyerId         String    @map("buyer_id") @db.Uuid
  sellerId        String    @map("seller_id") @db.Uuid
  shopId          String    @map("shop_id") @db.Uuid
  lastMessageId   String?   @unique @map("last_message_id") @db.Uuid
  lastActivityAt  DateTime  @default(now()) @map("last_activity_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  buyer       User      @relation("buyerConversations", fields: [buyerId], references: [id])
  seller      User      @relation("sellerConversations", fields: [sellerId], references: [id])
  shop        Shop      @relation(fields: [shopId], references: [id])
  lastMessage Message?  @relation("lastMessage", fields: [lastMessageId], references: [id])
  messages    Message[] @relation("conversationMessages")
  invoices    Invoice[]

  @@unique([buyerId, sellerId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([lastActivityAt])
  @@map("conversations")
}

model Message {
  id               String      @id @default(uuid()) @db.Uuid
  conversationId   String      @map("conversation_id") @db.Uuid
  senderId         String?     @map("sender_id") @db.Uuid
  type             MessageType
  content          String?
  voiceUrl         String?     @map("voice_url")
  voiceDurationMs  Int?        @map("voice_duration_ms")
  imageUrl         String?     @map("image_url")
  invoiceId        String?     @unique @map("invoice_id") @db.Uuid
  contextProductId String?     @map("context_product_id") @db.Uuid
  editedAt         DateTime?   @map("edited_at")
  createdAt        DateTime    @default(now()) @map("created_at")

  conversation   Conversation     @relation("conversationMessages", fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?            @relation(fields: [senderId], references: [id])
  invoice        Invoice?         @relation(fields: [invoiceId], references: [id])
  contextProduct Product?         @relation("contextProduct", fields: [contextProductId], references: [id])
  lastForConvo   Conversation?    @relation("lastMessage")
  reads          MessageRead[]
  reactions      MessageReaction[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageRead {
  messageId   String    @map("message_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  deliveredAt DateTime? @map("delivered_at")
  readAt      DateTime? @map("read_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
  @@map("messages_read")
}

model MessageReaction {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([messageId])
  @@map("message_reactions")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  sellerId       String        @map("seller_id") @db.Uuid
  buyerId        String        @map("buyer_id") @db.Uuid
  status         InvoiceStatus @default(pending)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(12, 2)
  platformFee    Decimal       @default(0) @map("platform_fee") @db.Decimal(12, 2)
  paystackRef    String?       @unique @map("paystack_ref")
  paidAt         DateTime?     @map("paid_at")
  cancelledAt    DateTime?     @map("cancelled_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  seller       User          @relation("invoiceSeller", fields: [sellerId], references: [id])
  buyer        User          @relation("invoiceBuyer", fields: [buyerId], references: [id])
  lines        InvoiceLine[]
  message      Message?
  transaction  Transaction?

  @@index([conversationId])
  @@index([buyerId, status])
  @@index([sellerId, status])
  @@map("invoices")
}

model InvoiceLine {
  id              String            @id @default(uuid()) @db.Uuid
  invoiceId       String            @map("invoice_id") @db.Uuid
  kind            InvoiceLineKind
  productId       String?           @map("product_id") @db.Uuid
  name            String
  quantity        Int               @default(1)
  unitPrice       Decimal           @map("unit_price") @db.Decimal(12, 2)
  status          InvoiceLineStatus @default(pending)
  position        Int               @default(0)
  resolvedAt      DateTime?         @map("resolved_at")
  autoReleaseAt   DateTime?         @map("auto_release_at")
  extendedAt      DateTime?         @map("extended_at")
  extensionReason String?           @map("extension_reason") @db.VarChar(200)
  createdAt       DateTime          @default(now()) @map("created_at")

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation("invoiceLineProduct", fields: [productId], references: [id])
  dispute Dispute?
  review  Review?

  @@index([invoiceId])
  @@index([status, autoReleaseAt])
  @@map("invoice_lines")
}

model Transaction {
  id          String            @id @default(uuid()) @db.Uuid
  invoiceId   String            @unique @map("invoice_id") @db.Uuid
  buyerId     String            @map("buyer_id") @db.Uuid
  sellerId    String            @map("seller_id") @db.Uuid
  totalPaid   Decimal           @map("total_paid") @db.Decimal(12, 2)
  platformFee Decimal           @default(0) @map("platform_fee") @db.Decimal(12, 2)
  paystackRef String            @unique @map("paystack_ref")
  status      TransactionStatus @default(held)
  paidAt      DateTime?         @map("paid_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  buyer   User    @relation("buyerTransactions", fields: [buyerId], references: [id])
  seller  User    @relation("sellerTransactions", fields: [sellerId], references: [id])

  @@index([buyerId])
  @@index([sellerId])
  @@map("transactions")
}

model Dispute {
  id            String             @id @default(uuid()) @db.Uuid
  invoiceLineId String             @unique @map("invoice_line_id") @db.Uuid
  raisedById    String             @map("raised_by_id") @db.Uuid
  reason        String
  evidenceUrl   String?            @map("evidence_url")
  status        DisputeStatus      @default(open)
  resolution    DisputeResolution?
  createdAt     DateTime           @default(now()) @map("created_at")
  resolvedAt    DateTime?          @map("resolved_at")

  invoiceLine InvoiceLine @relation(fields: [invoiceLineId], references: [id], onDelete: Cascade)
  raisedBy    User        @relation("disputesRaised", fields: [raisedById], references: [id])

  @@map("disputes")
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String
  title      String?
  body       String?
  link       String?
  payload    Json
  readAt     DateTime? @map("read_at")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, archivedAt, readAt])
  @@map("notifications")
}

model DiscoverPost {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @map("shop_id") @db.Uuid
  videoUrl    String   @map("video_url")
  posterUrl   String?  @map("poster_url")
  caption     String?
  ctaType     String   @map("cta_type")
  ctaTargetId String   @map("cta_target_id") @db.Uuid
  impressions Int      @default(0)
  clicks      Int      @default(0)
  saves       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  shop      Shop               @relation(fields: [shopId], references: [id])
  campaigns DiscoverCampaign[]

  @@index([shopId])
  @@map("discover_posts")
}

model DiscoverCampaign {
  id          String    @id @default(uuid()) @db.Uuid
  postId      String    @map("post_id") @db.Uuid
  plan        BoostPlan
  spend       Decimal   @db.Decimal(12, 2)
  startsAt    DateTime  @map("starts_at")
  endsAt      DateTime  @map("ends_at")
  paystackRef String?   @unique @map("paystack_ref")
  createdAt   DateTime  @default(now()) @map("created_at")

  post  DiscoverPost        @relation(fields: [postId], references: [id])
  daily DiscoverDailyStat[]

  @@index([postId, endsAt])
  @@map("discover_campaigns")
}

model DiscoverDailyStat {
  id          String   @id @default(uuid()) @db.Uuid
  campaignId  String   @map("campaign_id") @db.Uuid
  date        DateTime @db.Date
  impressions Int      @default(0)
  clicks      Int      @default(0)
  spend       Decimal  @default(0) @db.Decimal(12, 2)

  campaign DiscoverCampaign @relation(fields: [campaignId], references: [id])

  @@unique([campaignId, date])
  @@map("discover_daily_stats")
}

model Boost {
  id          String    @id @default(uuid()) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  plan        BoostPlan
  spend       Decimal   @db.Decimal(12, 2)
  startsAt    DateTime  @map("starts_at")
  endsAt      DateTime  @map("ends_at")
  paystackRef String?   @unique @map("paystack_ref")
  createdAt   DateTime  @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, endsAt])
  @@map("boosts")
}

model Story {
  id         String   @id @default(uuid()) @db.Uuid
  shopId     String   @map("shop_id") @db.Uuid
  mediaUrl   String   @map("media_url")
  durationMs Int      @default(5000) @map("duration_ms")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  shop Shop @relation(fields: [shopId], references: [id])

  @@index([shopId, expiresAt])
  @@map("stories")
}

model Review {
  id            String   @id @default(uuid()) @db.Uuid
  invoiceLineId String   @unique @map("invoice_line_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  shopId        String   @map("shop_id") @db.Uuid
  authorId      String   @map("author_id") @db.Uuid
  rating        Int
  body          String?
  createdAt     DateTime @default(now()) @map("created_at")

  invoiceLine InvoiceLine @relation(fields: [invoiceLineId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])
  shop        Shop        @relation(fields: [shopId], references: [id])
  author      User        @relation(fields: [authorId], references: [id])

  @@map("reviews")
}

model Referral {
  id          String         @id @default(uuid()) @db.Uuid
  referrerId  String         @map("referrer_id") @db.Uuid
  inviteeId   String?        @map("invitee_id") @db.Uuid
  code        String
  status      ReferralStatus @default(pending)
  rewardNaira Int            @default(500) @map("reward_naira")
  createdAt   DateTime       @default(now()) @map("created_at")
  completedAt DateTime?      @map("completed_at")

  referrer User  @relation("referrer", fields: [referrerId], references: [id])
  invitee  User? @relation("invitee", fields: [inviteeId], references: [id])

  @@unique([referrerId, inviteeId])
  @@index([inviteeId, status])
  @@map("referrals")
}

model WishlistItem {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@id([userId, productId])
  @@map("wishlist_items")
}
